    {
      "id": "b0013",
      "source": [
        "是以圣人之治，虚其心，实其腹，弱其志，强其骨。"
      ],
      "translations": {
        "en": [
          "Therefore the sage governs by emptying their hearts and filling their bellies, weakening their ambitions and strengthening their bones."
        ],
        "legge": [
          "Therefore the sage, in the exercise of his government, empties their minds, fills their bellies, weakens their wills, and strengthens their bones."
        ]
      },
